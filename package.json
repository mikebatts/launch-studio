{
  "name": "launch-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test server/*.test.ts tests/*.test.ts src/draft-state.test.ts src/journey.test.tsx",
    "start": "tsx server/index.ts"
  },
  "dependencies": {
    "@fontsource/nunito-sans": "^5.3.0",
    "chess.js": "^1.4.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "pdf-parse": "^2.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jsdom": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.0"
  },
  "engines": {
    "node": "22.x"
  }
}
